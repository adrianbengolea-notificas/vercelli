rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role in ['admin', 'editor'];
    }

    match /lines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /routes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stops/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /serviceCalendars/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /serviceAlerts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /institutionalPages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /contactRequests/{id} {
      allow create: if request.resource.data.keys().hasAll(['nombre','email','mensaje']);
      allow read, update, delete: if isAdmin();
    }
    match /complaints/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /lostObjects/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /jobApplications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /administrators/{id} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
